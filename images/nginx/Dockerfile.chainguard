# Chainguard (Wolfi) based nginx image. The "-dev" variant ships a busybox shell
# and apk, required by the Gravitee run.sh entrypoint. The wolfi base ships nginx
# as uid 65532; we remap it to uid/gid 101 below to match the debian image and the
# Helm chart securityContext (runAsUser: 101), keeping both variants interchangeable.
ARG CHAINGUARD_ORG=gravitee.io
# Set CHAINGUARD_IMAGE=nginx-fips to build the FIPS-140-3 variant (FIPS-validated OpenSSL).
ARG CHAINGUARD_IMAGE=nginx
ARG NGINX_VERSION=1.30
FROM cgr.dev/${CHAINGUARD_ORG}/${CHAINGUARD_IMAGE}:${NGINX_VERSION}-dev
LABEL maintainer="contact@graviteesource.com"

USER root

ENV WWW_TARGET=/usr/share/nginx/html
ENV HTTP_PORT=8080
ENV HTTPS_PORT=8443
ENV SERVER_NAME=_

COPY nginx.conf /etc/nginx/
# envsubst is shipped as a small busybox-sed script (see ./envsubst) instead of
# the gettext package, to avoid an external dependency: gettext is absent from
# the org's apk catalog, and staying on busybox keeps the runtime image free of
# any added/ungoverned binary.
COPY --chmod=0755 envsubst /usr/local/bin/envsubst

# Remap the nginx user/group from the wolfi default (65532) to 101, so it matches
# the debian image and the Helm chart's securityContext (runAsUser: 101). uid/gid
# 101 is free in the wolfi base. Downstream component images reference the "nginx"
# user by name (chown nginx:root / USER nginx), so this remap propagates to them.
RUN sed -i 's/^nginx:x:65532:65532:/nginx:x:101:101:/' /etc/passwd; \
  sed -i 's/^nginx:x:65532:/nginx:x:101:/' /etc/group; \
  mkdir -p /rw.mount/nginx/logs /var/cache/nginx /var/log/nginx; \
  ln -sf /dev/stdout /var/log/nginx/access.log; \
  ln -sf /dev/stderr /var/log/nginx/error.log; \
  chown -R 101:0 /usr/share/nginx /var/log/nginx /var/cache/nginx /rw.mount /var/run; \
  chmod -R g+w /var/cache/nginx /rw.mount

COPY run.sh /run.sh

# Drop back to the non-root nginx user (now uid 101) so the image does not run as
# root by default. Component images re-elevate to root for their own chown step.
USER nginx

# The base image declares ENTRYPOINT ["/usr/sbin/nginx"]; reset it so the
# Gravitee run.sh wrapper is the entrypoint instead.
ENTRYPOINT []
CMD ["sh", "/run.sh"]

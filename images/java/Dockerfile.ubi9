FROM redhat/ubi9:9.8
LABEL maintainer="contact@graviteesource.com"

# Default to UTF-8 file.encoding
ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en' LC_ALL='en_US.UTF-8'

ARG JAVA_VERSION
ENV JAVA_VERSION=${JAVA_VERSION:-21-jre}

RUN set -eux; \
    dnf upgrade --assumeyes; \
    # Add Adoptium RPM repository (mirrors the apt-based approach in Dockerfile.debian)
    rpm --import https://packages.adoptium.net/artifactory/api/gpg/key/public; \
    printf '%s\n' \
        '[Adoptium]' \
        'name=Adoptium' \
        'baseurl=https://packages.adoptium.net/artifactory/rpm/rhel/$releasever/$basearch' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://packages.adoptium.net/artifactory/api/gpg/key/public' \
        | tee /etc/yum.repos.d/adoptium.repo; \
    dnf install --assumeyes "temurin-${JAVA_VERSION}"; \
    # fontconfig and dejavu fonts added to support server-side image generation by Java programs
    # Notes vs Alpine:
    #   libretls, musl-locales, libc6-compat are Alpine/musl-specific — not needed on glibc
    #   ttf-dejavu → dejavu-sans-fonts + dejavu-serif-fonts + dejavu-sans-mono-fonts
    #   --allowerasing lets full curl replace the curl-minimal pre-installed in UBI9
    #   htop excluded: its libhwloc dependency is unavailable in the UBI9 repo subset
    #   jattach excluded: not in standard RHEL repos; build from source if needed
    #     see https://github.com/apangin/jattach/releases
    dnf install --assumeyes --allowerasing \
        curl \
        dejavu-sans-fonts \
        dejavu-serif-fonts \
        dejavu-sans-mono-fonts \
        fontconfig \
        glibc-langpack-en \
        libgcc \
        libstdc++ \
        openssl \
        tzdata \
        zlib; \
    dnf clean all; \
    rm -rf /var/cache/dnf/*

RUN echo "Verifying install with: java --version"; \
    java --version; \
    echo "Complete."

RUN groupadd --gid 1000 graviteeio \
    && useradd --home-dir /home/graviteeio --uid 1001 --gid 1000 --create-home graviteeio
ENV HOME=/home/graviteeio

USER graviteeio
CMD ["java", "-version"]
